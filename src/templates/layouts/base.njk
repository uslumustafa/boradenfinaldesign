<!doctype html>
<html lang="tr" class="no-js" data-fx="auto">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ page.titleFull }}</title>
  <meta name="description" content="{{ page.description }}">
  {% if page.noindex %}<meta name="robots" content="noindex">{% endif %}
  {% if page.canonical %}<link rel="canonical" href="{{ page.canonical }}">{% endif %}
  <meta name="theme-color" content="#08132a">
  <meta property="og:type" content="{{ page.ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ page.titleFull }}">
  <meta property="og:description" content="{{ page.description }}">
  <meta property="og:locale" content="tr_TR">
  {% if page.canonical %}<meta property="og:url" content="{{ page.canonical }}">{% endif %}
  <meta property="og:image" content="{{ share_image.url }}">
  <meta property="og:image:alt" content="{{ share_image.alt }}">
  <meta property="og:image:width" content="{{ share_image.width }}">
  <meta property="og:image:height" content="{{ share_image.height }}">
  {% if page.ogType == 'article' and page.published %}<meta property="article:published_time" content="{{ page.published }}">{% endif %}
  {# geniş kart yalnızca paylaşım görseli en az 1200 px genişse (şimdilik logo yer tutucu: küçük kart) #}
  <meta name="twitter:card" content="{{ 'summary_large_image' if share_image.width >= 1200 else 'summary' }}">
  <link rel="icon" href="data:,">
  <link rel="preload" href="/assets/fonts/montserrat-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/open-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/site.css?v={{ build_id }}">
  {% block head_extra %}{% endblock %}
  <script>
    /* Erken: efekt katmanı + animasyon sınıfı (içerik gizleme yalnızca JS çalışıyorsa) */
    (function () {
      var d = document.documentElement;
      d.classList.remove('no-js');
      d.classList.add('js');
      var m = null;
      try { m = localStorage.getItem('boraden-fx'); } catch (e) {}
      var r = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
      /* çok zayıf cihaz (fx.js › detect ile aynı eşik): efektler ilk boyamadan kapalı — sonradan kapanıp sayfa yeniden dizilmesin */
      var low = (navigator.deviceMemory || 8) <= 1 || (navigator.hardwareConcurrency || 8) <= 2;
      var fx = m || (r || low ? 'off' : 'auto');
      d.setAttribute('data-fx', fx);
      if (fx !== 'off') d.classList.add('js-anim');
      /* Sayfa kahramanında başlık sütunu: ilk boyamada efekt kapalıysa daralmaz (30-layout.css). Sonradan kendiliğinden kapanma
         (WebGL yok, bağlam kaybı, yavaş cihazda düşürme) açık sayfayı yeniden dizmez; yeni sayfada uygulanır (fx.js › syncLayout). */
      if (fx === 'off') d.classList.add('hero-wide');
      /* Açılış sahnesi (≈2,2 sn, atlanabilir): yalnızca ana sayfaya İLK gelişte — adres çubuğu/dış bağlantı; yeniden yükleme, geri-ileri ve site içi gezintide yok.
         Otomasyon (webdriver) ve veri tasarrufu açıkken atlanır (?intro ile zorlanabilir). Depolama kullanılmaz. */
      try {
        var nv = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        var cn = navigator.connection;
        if (location.pathname === '/' && !location.hash && fx !== 'off' && (!nv || nv.type === 'navigate') &&
            (!document.referrer || document.referrer.indexOf(location.origin) !== 0) && !(cn && cn.saveData) &&
            (!navigator.webdriver || /[?&]intro\b/.test(location.search))) d.classList.add('is-opening');
      } catch (e) {}
      /* güvenlik ağı: ana betik yüklenemezse içerik görünür kalsın */
      setTimeout(function () {
        if (!window.__boraden) { d.classList.remove('js-anim', 'is-opening'); d.classList.add('is-ready'); }
      }, 3500);
      setTimeout(function () { d.classList.remove('is-opening'); }, 7000);
    })();
  </script>
</head>
<body class="{{ page.bodyClass }}">
  <a class="skip" href="#main">İçeriğe geç</a>

  {# Kalıcı dünya: sayfalar arasında değişmez; içerik üstüne biner #}
  <div class="world" id="world" aria-hidden="true">
    <div class="world__bg"></div>
    <div class="world__floor"></div>
    <canvas id="world-canvas"></canvas>
  </div>

  {% include "partials/header.njk" %}
  <div class="prog" aria-hidden="true"><div class="prog__fill"></div></div>

  <main id="main" tabindex="-1"
        data-scene="{{ page.scene if page.scene !== null else '' }}"{% if page.fig %}
        data-shapes="{{ page.fig }}"{% endif %}
        data-url="{{ page.url }}"
        data-title="{{ page.titleFull }}"
        data-body-class="{{ page.bodyClass }}">
    {% block main %}{% endblock %}
  </main>

  {% include "partials/footer.njk" %}

  <div class="sr-only" id="live" role="status" aria-live="polite" aria-atomic="true"></div>

  <script type="module" src="/assets/js/main.js?v={{ build_id }}"></script>
</body>
</html>
