{% extends "layouts/base.njk" %}
{% import "partials/macros.njk" as m %}

{% block head_extra %}
<script type="application/ld+json">{{ ld | json_script }}</script>
{% endblock %}

{# Sektör raporları. Wagtail karşılığı: ReportIndexPage + Report snippet'i — alanlar: title, period, publisher, published_at
   (boş olabilir), url (dış), report_url?, announcement_url?, summary, kind (İstatistik/Rapor/Araştırma), checked_at.
   Süzme ve arama: listing.js (data-listing). Satırlar #id çapasıyla site içi aramadan doğrudan açılır. #}
{% block main %}
{{ m.phero(page, copy.title, copy.lead, "Bilgi merkezi · Kaynaklar", page.scene, [(reports | length) ~ " kaynak", kindsLabel, ("Son kontrol " ~ (lastChecked | date_tr)) if lastChecked else null]) }}

<div class="sheet sec--paper">
  <div class="container" data-listing="reports">

    <div class="notice rp-note" data-reveal>
      <p><strong>Kaynaklar hakkında.</strong> {{ copy.note }}</p>
    </div>

    <div class="toolbar rp-toolbar">
      <div class="chips" role="group" aria-label="Türe göre süzün" data-filter-by="kind">
        <button class="chip is-on" type="button" data-filter="all" aria-pressed="true">Tümü<span class="rp-chipn tnum">{{ reports | length }}</span></button>
        {% for k in kinds %}<button class="chip" type="button" data-filter="{{ k.slug }}" aria-pressed="false"><i class="dot rp-dot--{{ k.slug }}" aria-hidden="true"></i>{{ k.label }}<span class="rp-chipn tnum">{{ k.count }}</span></button>{% endfor %}
      </div>
      <label class="searchbox">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg>
        <span class="sr-only">Raporlarda ara</span>
        <input type="search" placeholder="Kurum, başlık veya dönem ara…" data-search autocomplete="off">
      </label>
    </div>
    <p class="rp-count mono" data-result-count aria-live="polite"></p>

    <ol class="rp-list" data-steps>
      {% for r in reports %}
      <li class="rp-row" id="{{ r.id }}" data-item data-kind="{{ r.kindSlug }}"
          data-text="{{ (r.title ~ ' ' ~ r.publisher ~ ' ' ~ r.period ~ ' ' ~ r.kind ~ ' ' ~ r.summary ~ ' ' ~ r.host) | lower_tr }}">
        <div class="rp-date" data-reveal>
          {% if r.publishedAt %}
          <time datetime="{{ r.publishedAt }}">
            <span class="rp-day tnum">{{ r.publishedAt | day_of }}</span>
            <span class="rp-mon mono">{{ r.publishedAt | month_short }} {{ r.publishedAt | year_of }}</span>
          </time>
          {% else %}
          <span class="rp-day rp-day--na" aria-hidden="true">—</span>
          <span class="rp-mon mono">Tarih bilgisi yok</span>
          {% endif %}
          <span class="rp-dlabel mono">Yayın</span>
        </div>
        <div class="rp-main" data-reveal data-reveal-delay="1">
          <p class="rp-pub"><span class="sr-only">Yayımlayan: </span>{% for p in r.publishers %}<span class="chip rp-chip">{{ p }}</span>{% endfor %}</p>
          <h2 class="rp-title">
            <a href="{{ r.url }}" target="_blank" rel="noopener noreferrer">{{ r.title }}<span class="sr-only"> (yeni sekmede açılır)</span><span class="rp-ext" aria-hidden="true">↗</span></a>
          </h2>
          <p class="rp-sum">{{ r.summary }}</p>
          <p class="rp-host mono">{{ r.host }}</p>
          {% if r.extra.length %}
          <ul class="rp-links">
            {% for x in r.extra %}<li><a class="rp-link" href="{{ x.url }}" target="_blank" rel="noopener noreferrer">{{ x.label }}<span class="sr-only"> (yeni sekmede açılır)</span><span aria-hidden="true">↗</span></a></li>{% endfor %}
          </ul>
          {% endif %}
        </div>
        <dl class="rp-meta" data-reveal data-reveal-delay="2">
          <div><dt>Tür</dt><dd><i class="dot rp-dot--{{ r.kindSlug }}" aria-hidden="true"></i>{{ r.kind }}</dd></div>
          <div><dt>Dönem</dt><dd>{{ r.period }}</dd></div>
          <div><dt>Son kontrol</dt><dd><time datetime="{{ r.checkedAt }}">{{ r.checkedAt | date_short }}</time></dd></div>
        </dl>
      </li>
      {% endfor %}
    </ol>
    <p class="empty" data-empty hidden>Aramanızla eşleşen rapor bulunamadı. <span class="empty__go"><a class="textlink" href="/arama/" data-empty-search>Sitenin tamamında arayın →</a> <a class="textlink" href="/iletisim/">Bize yazın →</a></span></p>

    <div class="g12 rp-how">
      <p class="eyebrow gc" style="--gc: 1 / span 4" data-reveal>Nasıl okunur</p>
      <dl class="gc rp-how__list" style="--gc: 5 / -1">
        <div data-reveal><dt>Dönem</dt><dd>Raporun ya da istatistiğin kapsadığı yıl, ay veya değerlendirme dönemi.</dd></div>
        <div data-reveal data-reveal-delay="1"><dt>Yayın</dt><dd>Kurumun yayını ya da duyuruyu yayımladığı tarih. Tarih bilgisi bulunmayan kayıtlarda boş bırakılır.</dd></div>
        <div data-reveal data-reveal-delay="2"><dt>Son kontrol</dt><dd>Bağlantının bu sayfada en son gözden geçirildiği tarih. Kurumlar sayfalarını güncelleyebilir; içerik için her zaman kaynak sayfa esas alınmalıdır.</dd></div>
      </dl>
    </div>
  </div>
</div>

{% set cta_title = "Rakamları birlikte okuyalım." %}
{% set cta_text = "Sektör verilerinin şirketinizin bütçe, raporlama ve değerleme çalışmalarındaki yerini konuşalım." %}
{% include "partials/cta.njk" %}
{% endblock %}
