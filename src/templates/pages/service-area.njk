{% extends "layouts/base.njk" %}
{% import "partials/macros.njk" as m %}
{% import "partials/people.njk" as pp %}
{% import "partials/blocks.njk" as bk %}

{% block head_extra %}
<script type="application/ld+json">{{ ld | json_script }}</script>
{% endblock %}

{# Hizmet alanı sayfası. Wagtail karşılığı: ServiceAreaPage (alt sayfalar: ServicePage; photo = görsel seçici).
   Hizmet kartları alt sayfalardan, SSS toplamı ve ilgili sektör/hesaplayıcılar ilişkilerden HESAPLANIR (scripts/relations.mjs);
   genel SSS = FaqItem.show_on_services. Bölümler veri yoksa çizilmez; HUD bölüm noktaları data-chapter'dan gelir. #}
{% block main %}
{% set rel = group.related %}
{% set nSvc = group.services | length %}
{% set nFaq = (rel.faq | length) + (model.generalFaq | length) %}
{% set hasRel = (rel.sectors | length) or (rel.calculators | length) %}
{{ m.phero(page, group.name, group.description, "Hizmet alanı · " ~ group.number, page.scene, [nSvc ~ " hizmet başlığı"]) }}

<div class="sheet sec--paper">
  <div class="container">

    {{ bk.kunye(group.number, [
      { k: "Hizmet", v: nSvc ~ " başlık" },
      { k: "Sektör", v: ((rel.sectors | length) ~ " sektör sayfasında") if (rel.sectors | length) else "" },
      { k: "Hesaplayıcı", v: ((rel.calculators | length) ~ " ilgili araç") if (rel.calculators | length) else "" }
    ], { label: "Hizmet alanı künyesi" }) }}

    <div class="g12 areahead">
      <p class="eyebrow gc" style="--gc: 1 / span 4" data-reveal>Kapsam</p>
      <p class="areahead__text gc" style="--gc: 5 / -1" data-lit>{{ group.scope }}</p>
    </div>

    {{ bk.figure(group.photo, { cls: "sfig--wide areaband", sizes: "(min-width: 1100px) 1300px, 100vw" }) }}

    <section class="areasec" id="hizmetler" data-chapter="Hizmetler" aria-labelledby="areasvc-h">
      <h2 class="svc__label mono" id="areasvc-h" data-reveal>Hizmet başlıkları</h2>
      <div class="g12 areasvc">
      <div class="gc areasvc__fig" style="--gc: 1 / span 4">{{ m.fig("pv", group.shape) }}</div>
      <ol class="acards gc" style="--gc: 5 / -1">
        {% for s in group.services %}
        <li data-reveal data-reveal-delay="{{ loop.index0 % 2 }}" data-shape-hover="{{ s.shape }}">
          <a class="acard acard--{{ ['b', 'r', 'g'][loop.index0 % 3] }}" href="{{ s.url }}">
            <span class="acard__n mono tnum">{{ s.ref }}</span>
            <span class="acard__t">{{ s.title }}</span>
            <span class="acard__d">{{ s.lead }}</span>
            {% if s.scopeItems | length %}
            <span class="acard__scope">
              {% for it in s.scopeItems %}<span>{{ it.title }}</span>{% endfor %}
            </span>
            {% endif %}
            <span class="acard__go">Hizmeti inceleyin {{ m.arrow() }}</span>
          </a>
        </li>
        {% endfor %}
      </ol>
      </div>
    </section>

    {% if group.feature %}
    {# Alana özel bölümler (content.json › groups[].feature; şimdilik Hukuk ve Teşvik). Hepsi hizmet kayıtlarından HESAPLANIR:
       «Hangi durumda?» = services[].needs; mevzuat/kurumlar = services[].sourceKeys → sources (scripts/model.mjs › group.basis).
       Wagtail karşılığı: ServiceAreaPage.feature (seçim) + hizmetlerin «Şu durumlarda» listesi ve kaynak snippet'leri. #}
    <section class="areasec sitsec" id="durumlar" data-chapter="Durumlar" aria-labelledby="sit-h">
      <div class="g12">
        <div class="gc" style="--gc: 1 / span 4">
          <h2 class="svc__label mono" id="sit-h" data-reveal>Hangi durumda?</h2>
          <p class="sitsec__lead" data-reveal data-reveal-delay="1">Durumunuza en yakın kartı seçin; ilgili hizmetin sayfasında kapsamı, süreci ve hazırlanması gerekenleri bulursunuz.</p>
        </div>
        <ul class="gc sitgrid" style="--gc: 5 / -1">
          {% for s in group.services %}{% if s.needs | length %}
          <li class="sit sit--{{ ['b', 'r', 'g'][loop.index0 % 3] }}" data-reveal data-reveal-delay="{{ loop.index0 % 2 }}">
            <ul class="sit__list">
              {% for n in s.needs %}<li>{{ n }}</li>{% endfor %}
            </ul>
            <a class="sit__svc" href="{{ s.url }}"><span class="sit__n mono tnum">{{ s.ref }}</span><span class="sit__t">{{ s.title }}</span>{{ m.arrow() }}</a>
          </li>
          {% endif %}{% endfor %}
        </ul>
      </div>
    </section>

    {% if group.feature == "mevzuat" and (group.basis.laws | length) %}
    <section class="areasec lawsec" id="mevzuat" data-chapter="Mevzuat" aria-labelledby="law-h">
      <div class="g12">
        <div class="gc" style="--gc: 1 / span 4">
          <h2 class="svc__label mono" id="law-h" data-reveal>Mevzuat dayanakları</h2>
          <p class="sitsec__lead" data-reveal data-reveal-delay="1">Bu alandaki hizmetlerin dayandığı kanunlar; güncel metinler Mevzuat Bilgi Sistemi'nde.</p>
        </div>
        <div class="gc" style="--gc: 5 / -1">
          <ul class="lawgrid">
            {% for b in group.basis.laws %}
            <li class="law" data-reveal data-reveal-delay="{{ loop.index0 % 3 }}">
              <a class="law__a" href="{{ b.url }}" target="_blank" rel="noopener noreferrer">
                <span class="law__no tnum">{{ b.lawNo }}</span>
                <span class="law__k mono">sayılı</span>
                <span class="law__t">{{ b.lawName }}</span>
                <span class="law__go mono">Metni okuyun <span aria-hidden="true">↗</span><span class="sr-only"> (yeni sekmede açılır)</span></span>
              </a>
              <p class="law__svc">{% for sv in b.services %}<a href="{{ sv.url }}">{{ sv.title }}</a>{% endfor %}</p>
            </li>
            {% endfor %}
          </ul>
          {% if group.basis.others | length %}
          <p class="lawsec__k mono" data-reveal>Kurum ve sistemler</p>
          <ul class="srclist" data-reveal>
            {% for b in group.basis.others %}
            <li><a class="srclink" href="{{ b.url }}" target="_blank" rel="noopener noreferrer"><span>{{ b.label }}</span><span class="srclink__go" aria-hidden="true">↗</span><span class="sr-only"> (yeni sekmede açılır)</span></a></li>
            {% endfor %}
          </ul>
          {% endif %}
        </div>
      </div>
    </section>
    {% endif %}

    {% if group.feature == "kurumlar" and (group.basis.byIssuer | length) %}
    <section class="areasec orgsec" id="kurumlar" data-chapter="Kurumlar" aria-labelledby="org-h">
      <div class="g12">
        <div class="gc" style="--gc: 1 / span 4">
          <h2 class="svc__label mono" id="org-h" data-reveal>Kurumlar ve programlar</h2>
          <p class="sitsec__lead" data-reveal data-reveal-delay="1">Bu alandaki hizmetlerin dayandığı destek programları ve düzenlemeler; bağlantılar kurumların resmî sayfalarına gider.</p>
        </div>
        <ul class="gc orggrid" style="--gc: 5 / -1">
          {% for o in group.basis.byIssuer %}
          <li class="org" data-reveal data-reveal-delay="{{ loop.index0 % 2 }}">
            <h3 class="org__h">{{ o.issuer }}</h3>
            <ul class="org__list">
              {% for b in o.items %}
              <li>
                <a class="org__a" href="{{ b.url }}" target="_blank" rel="noopener noreferrer">{{ b.title }}<span aria-hidden="true"> ↗</span><span class="sr-only"> (yeni sekmede açılır)</span></a>
                <span class="org__svc">{% for sv in b.services %}{{ sv.title }}{% if not loop.last %} · {% endif %}{% endfor %}</span>
              </li>
              {% endfor %}
            </ul>
          </li>
          {% endfor %}
        </ul>
      </div>
    </section>
    {% endif %}
    {% endif %}

    {% if nFaq %}
    <section class="areasec areafaq" id="sss" data-chapter="Sorular" aria-labelledby="areafaq-h">
      <div class="g12">
        <div class="gc" style="--gc: 1 / span 4">
          <h2 class="svc__label mono" id="areafaq-h" data-reveal>Sık sorulanlar</h2>
        </div>
        <div class="gc" style="--gc: 5 / -1">
          <div class="faq" data-reveal>
            {% for f in rel.faq %}
            <details>
              <summary>{{ f.q }}</summary>
              <div class="faq__a">
                <p>{{ f.a }}</p>
                <p class="faq__from"><a class="textlink" href="{{ f.serviceUrl }}">{{ f.serviceTitle }} {{ m.arrow() }}</a></p>
              </div>
            </details>
            {% endfor %}
            {% for f in model.generalFaq %}
            <details>
              <summary>{{ f.q }}</summary>
              <div class="faq__a">{{ f.a | paras_rich }}</div>
            </details>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>
    {% endif %}

    {% if hasRel %}
    <section class="areasec arearel" id="ilgili" data-chapter="İlgili" aria-labelledby="arearel-h">
      <div class="g12">
        <div class="gc" style="--gc: 1 / span 4">
          <h2 class="svc__label mono" id="arearel-h" data-reveal>İlgili içerik</h2>
        </div>
        <div class="gc" style="--gc: 5 / -1">
          {{ bk.related({ sectors: rel.sectors, calculators: rel.calculators, terms: [], posts: [] }, { maxSectors: 10, maxCalcs: 6, showCount: true }) }}
        </div>
      </div>
    </section>
    {% endif %}

    <div class="g12 areaother">
      <div class="gc" style="--gc: 1 / span 4">
        <p class="eyebrow" data-reveal>Diğer hizmet alanları</p>
      </div>
      <ul class="gc areaother__list" style="--gc: 5 / -1">
        {% for g in groups %}{% if g.id != group.id %}
        <li data-reveal>
          <a class="arow" href="{{ g.url }}">
            <span class="arow__n mono tnum">{{ g.number }}</span>
            <span class="arow__t">{{ g.name }}</span>
            <span class="arow__go" aria-hidden="true">→</span>
          </a>
        </li>
        {% endif %}{% endfor %}
      </ul>
    </div>

    <div class="notice" style="margin-top: clamp(3rem, 6vw, 5rem)" data-legal-review="BDY m.22">
      <p><strong>Bağımsızlık ilkesi.</strong> {{ site.independenceNote }}</p>
    </div>
  </div>
</div>

{# ── Çalışma biçimimiz: koyu bant; arkada alanın 3B sahnesi (veri: approach.json) #}
{{ bk.method(model.approach, { scene: group.scene }) }}

{# ── Alt bölüm: bu alanla ilgilenen kişiler (alan sorumluları + alandaki hizmetlere atananlar — scripts/team.mjs) #}
{{ pp.band(group.people, {
  id: "ekip",
  title: "Bu alanda sizinle ilgilenecek ekip.",
  lead: group.name ~ " alanındaki hizmetleri yürüten ekip arkadaşlarımız. Konunuza uygun kişiyle doğrudan görüşme talep edebilirsiniz.",
  label: "Bu alandaki hizmetleri"
}) }}

{% include "partials/cta.njk" %}
{% endblock %}
