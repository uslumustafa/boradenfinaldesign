{% extends "layouts/base.njk" %}
{% import "partials/macros.njk" as m %}

{% block head_extra %}
<script type="application/ld+json">{{ ld | json_script }}</script>
{% endblock %}

{# Yasal metin. Wagtail karşılığı: LegalPage — alanlar: title, status (Taslak / Yayında), updated_at, intro (RichText),
   sections (StreamField: id + heading + paragraphs + list), placeholders (InlinePanel: token + description), review_notes.
   Metindeki **kalın**, [etiket](/yol) ve [[Yer tutucu]] işaretlemesi `rich` süzgeciyle sunulur; şablonda hukuki metin yazılmaz.
   "Doldurulacak alanlar" ve "Hukuki inceleme notları" yalnızca durum Taslak iken görünür (yayımlanınca kendiliğinden kalkar). #}
{% block main %}
<section class="phero lg-hero sec--dark" data-world="{{ page.scene }}">
  <div class="container">
    <nav aria-label="Sayfa yolu">
      <ol class="crumbs">
        {% for c in page.crumbs %}<li><a href="{{ c.url }}">{{ c.label }}</a></li>{% endfor %}
        <li aria-current="page">{{ doc.title }}</li>
      </ol>
    </nav>
    <p class="eyebrow" data-reveal>Yasal metinler</p>
    <h1 data-reveal data-reveal-delay="1">{{ doc.title }}</h1>
    <div class="phero__meta" data-reveal data-reveal-delay="2">
      <span class="chip lg-status{% if draft %} lg-status--draft{% endif %}">{{ doc.status }}</span>
      <span class="chip"><span>Güncelleme: <time datetime="{{ doc.updatedAt }}">{{ doc.updatedAt | date_tr }}</time></span></span>
      <span class="chip">{{ doc.sections | length }} bölüm</span>
    </div>
  </div>
</section>

<div class="sheet sec--paper">
  <div class="container">
    {# yalnızca yazdırırken görünür: kahraman ve içindekiler basılmaz #}
    <div class="lg-printhead">
      <p class="lg-printhead__org">{{ site.legalName }}</p>
      <p class="lg-printhead__t">{{ doc.title }}</p>
      <p class="lg-printhead__m">{{ doc.status }} · Güncelleme: {{ doc.updatedAt | date_tr }} · {{ site.url }}{{ page.url }}</p>
    </div>

    {% if draft %}
    <div class="notice notice--warn lg-draft" role="note">
      <p><strong>Taslak.</strong> {{ draftNotice }}</p>
    </div>
    {% endif %}

    <div class="svc g12 lg-doc" data-module="legal-doc">
      <aside class="svc__side gc lg-side" style="--gc: 1 / span 3">
        <details class="lg-tocbox" open>
          <summary class="lg-tocbox__sum"><span>İçindekiler</span><span class="mono tnum">{{ doc.sections | length }} bölüm</span></summary>
          <nav class="toc lg-toc" data-toc aria-label="Bu metinde">
            <p class="toc__h mono">Bu metinde</p>
            <ol>
              {% for s in doc.sections %}
              <li><a href="#{{ s.id }}"><span class="lg-toc__n mono tnum">{{ s.num }}</span><span>{{ s.label }}</span></a></li>
              {% endfor %}
              {% if draft %}<li><a href="#taslak-notlari"><span class="lg-toc__n mono" aria-hidden="true">··</span><span>Taslak notları</span></a></li>{% endif %}
            </ol>
          </nav>
        </details>
        <button class="tbtn lg-printbtn" type="button" data-print hidden>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 9V3.5h10V9"/><rect x="3.5" y="9" width="17" height="8" rx="1"/><path d="M7 14h10v6.5H7z"/></svg>
          Yazdır
        </button>
        {{ m.fig("side") }}
      </aside>

      <article class="svc__main gc lg-main" style="--gc: 4 / span 8">
        <div class="lg-intro" data-reveal><p>{{ doc.intro | rich }}</p></div>

        {% for s in doc.sections %}
        <section class="lg-sec" id="{{ s.id }}" aria-labelledby="{{ s.id }}-h">
          <h2 class="lg-sec__h" id="{{ s.id }}-h"><span class="lg-sec__n mono tnum">{{ s.num }}</span><span class="lg-sec__l">{{ s.label }}</span></h2>
          <div class="lg-sec__body">
            {% for p in s.paragraphs %}<p>{{ p | rich }}</p>{% endfor %}
            {% if s.list and s.list.length %}
            <ul class="ticklist lg-list">
              {% for li in s.list %}<li>{{ li | rich }}</li>{% endfor %}
            </ul>
            {% endif %}
          </div>
        </section>
        {% endfor %}

        {% if draft %}
        <section class="lg-review" id="taslak-notlari" aria-labelledby="taslak-notlari-h">
          <h2 class="lg-review__h mono" id="taslak-notlari-h">Taslak notları</h2>
          <p class="lg-review__lead">Aşağıdaki bölümler yalnızca metin taslak durumundayken görünür; hukuki inceleme tamamlanıp metin yayımlandığında kaldırılır.</p>
          {% if doc.placeholders and doc.placeholders.length %}
          <details class="lg-det">
            <summary><span>Doldurulacak alanlar</span><span class="lg-det__n mono tnum">{{ doc.placeholders | length }}</span></summary>
            <div class="table-wrap">
              <table class="table lg-ph">
                <thead><tr><th scope="col">Yer tutucu</th><th scope="col">Açıklama</th></tr></thead>
                <tbody>
                  {% for ph in doc.placeholders %}
                  <tr><td><mark class="ph">{{ ph.token }}</mark></td><td>{{ ph.description | rich }}</td></tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </details>
          {% endif %}
          {% if doc.reviewNotes and doc.reviewNotes.length %}
          <details class="lg-det">
            <summary><span>Hukuki inceleme notları</span><span class="lg-det__n mono tnum">{{ doc.reviewNotes | length }}</span></summary>
            <ol class="lg-notes">
              {% for r in doc.reviewNotes %}<li>{{ r | rich }}</li>{% endfor %}
            </ol>
          </details>
          {% endif %}
        </section>
        {% endif %}
      </article>
    </div>

    {% if others.length %}
    <nav class="lg-others" aria-labelledby="lg-others-h">
      <h2 class="lg-others__h mono" id="lg-others-h">Diğer yasal metinler</h2>
      <ul class="lg-others__list">
        {% for o in others %}
        <li data-reveal data-reveal-delay="{{ loop.index0 }}">
          <a class="lg-other" href="{{ o.url }}">
            <span class="lg-other__t">{{ o.title }}</span>
            <span class="lg-other__m mono">{{ o.status }} · {{ o.updatedAt | date_short }}</span>
            <span class="lg-other__go" aria-hidden="true">→</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </nav>
    {% endif %}
  </div>
</div>

{% set cta_title = "Sorunuz mu var?" %}
{% set cta_text = "Bu metinlerle ilgili sorularınızı e-posta, telefon veya iletişim formu üzerinden iletebilirsiniz." %}
{% include "partials/cta.njk" %}
{% endblock %}
