{% extends "layouts/base.njk" %}
{% import "partials/macros.njk" as m %}

{% block main %}
{{ m.phero(page, "Hizmetler", "Altı hizmet alanında " ~ (services | length) ~ " başlık: vergi, denetim, danışmanlık, insan kaynakları, sistemler ve eğitim.", "Hizmet alanları", page.scene) }}

<div class="sheet sec--paper">
  <div class="container" data-listing="services">
    {# Alan kartları: gerçek arşiv karesi + sayı + tanım (hepsi alan kaydından). Wagtail: ServiceAreaPage.photo / description #}
    <ol class="agrid" aria-label="Hizmet alanları">
      {% for g in groups %}
      <li data-reveal data-reveal-delay="{{ loop.index0 % 3 }}">
        <a class="agc agc--{{ ['b', 'r', 'g'][loop.index0 % 3] }}" href="{{ g.url }}">
          <span class="agc__media" aria-hidden="true">{{ m.photo(g.photo, "(min-width: 1000px) 30vw, (min-width: 620px) 46vw, 92vw", "agc__img", false, "") }}</span>
          <span class="agc__body">
            <span class="agc__k mono tnum">{{ g.number }} / {{ groups | length | pad2 }}</span>
            <span class="agc__t">{{ g.name }}</span>
            <span class="agc__d">{{ g.description }}</span>
            <span class="agc__m mono"><b class="tnum">{{ g.services | length }}</b> hizmet başlığı</span>
            <span class="agc__go" aria-hidden="true">→</span>
          </span>
        </a>
      </li>
      {% endfor %}
    </ol>

    <div class="toolbar" style="margin-top:0">
      <div class="chips" role="group" aria-label="Alana göre filtrele" data-filter-by="group">
        <button class="chip is-on" type="button" data-filter="all" aria-pressed="true">Tümü</button>
        {% for g in groups %}<button class="chip" type="button" data-filter="{{ g.id }}" aria-pressed="false">{{ g.short }}</button>{% endfor %}
      </div>
      <label class="searchbox">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg>
        <span class="sr-only">Hizmetlerde ara</span>
        <input type="search" placeholder="Hizmet ara…" data-search autocomplete="off">
      </label>
    </div>

    {# Liste solda; sağda yapışkan şekil: bölüme göre alanın şekli, satırın üzerine gelince hizmetin şekli #}
    <div class="g12 sidx">
    <div class="gc sidx__list" style="--gc: 1 / span 8">
    {% for g in groups %}
    <section class="grp" data-group="{{ g.id }}" id="{{ g.slug }}"{% if not loop.first %} data-shape-at="{{ g.shape }}"{% endif %}>
      <header class="grp__head">
        <div>
          <span class="grp__no mono tnum">{{ g.number }} / {{ groups | length | pad2 }}</span>
          <h2><a href="{{ g.url }}">{{ g.name }}</a></h2>
          <p>{{ g.description }}</p>
        </div>
        <a class="textlink grp__all" href="{{ g.url }}">Alanı açın {{ m.arrow() }}</a>
      </header>
      <ul class="svclist">
        {% for s in g.services %}
        <li data-item data-text="{{ (s.title ~ ' ' ~ s.lead) | lower_tr }}" data-shape-hover="{{ s.shape }}">
          <a class="svcrow" href="{{ s.url }}">
            <span class="svcrow__t">{{ s.title }}</span>
            <span class="svcrow__d">{{ s.lead | truncate_words(18) }}</span>
            <span class="svcrow__go" aria-hidden="true">→</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endfor %}

    <p class="empty" data-empty hidden>Aramanızla eşleşen hizmet bulunamadı.</p>
    </div>
    <div class="gc sidx__fig" style="--gc: 9 / -1">{{ m.fig("pv", groups[0].shape) }}</div>
    </div>

    <div class="notice" style="margin-top:4rem" data-legal-review="BDY m.22">
      <p><strong>Bağımsızlık ilkesi.</strong> {{ site.independenceNote }}</p>
    </div>
  </div>
</div>

{% include "partials/cta.njk" %}
{% endblock %}
