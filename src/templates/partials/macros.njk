{# Duyarlı fotoğraf: data/photos.json manifestinden srcset üretir.
   Wagtail karşılığı: {% image page.image width-1200 %} + srcset. #}
{% macro photo(name, sizes="100vw", cls="", eager=false, alt=null) %}
{% set p = data.photos[name] %}
{% if p %}
<img class="{{ cls }}"
  src="/assets/img/photos/{{ name }}-{{ p.sizes | last }}.webp"
  srcset="{% for s in p.sizes %}/assets/img/photos/{{ name }}-{{ s }}.webp {{ s }}w{% if not loop.last %}, {% endif %}{% endfor %}"
  sizes="{{ sizes }}" width="{{ p.w }}" height="{{ p.h }}"
  alt="{{ alt if alt !== null else p.alt }}"
  {% if eager %}fetchpriority="high"{% else %}loading="lazy" decoding="async"{% endif %}>
{% endif %}
{% endmacro %}

{# Küçük ok simgesi (metin okunabilirliği için aria-hidden) #}
{% macro arrow() %}<span class="arr" aria-hidden="true">→</span>{% endmacro %}

{# Model tarih doğrulanmadığında date=null verir; UI hiçbir yerde kesin tarih ileri sürmez. #}
{% macro pubdate(pub, format="short", cls="") %}
{% if pub.date %}<time{% if cls %} class="{{ cls }}"{% endif %} datetime="{{ pub.date }}">{% if format == "tr" %}{{ pub.date | date_tr }}{% elif format == "long" %}{{ pub.date | date_long }}{% else %}{{ pub.date | date_short }}{% endif %}</time>{% else %}<span{% if cls %} class="{{ cls }}"{% endif %}>{{ pub.dateStatus }}</span>{% endif %}
{% endmacro %}

{# Bölüm başlığı: etiket + başlık + (isteğe bağlı) açıklama #}
{% macro head(eyebrow, title, lead="", cls="") %}
<header class="sechead {{ cls }}">
  <p class="eyebrow" data-reveal>{{ eyebrow }}</p>
  <h2 data-reveal data-reveal-delay="1">{{ title | safe }}</h2>
  {% if lead %}<p class="lead sechead__lead" data-reveal data-reveal-delay="2">{{ lead }}</p>{% endif %}
</header>
{% endmacro %}

{# Alt sayfa kahramanı: koyu bölüm, 3B dünya arkada. page: sayfa nesnesi (crumbs için) #}
{% macro phero(page, title, lead="", eyebrow="", scene=null, chips=[]) %}
{% set sc = scene if scene !== null else (page.scene or 0) %}
<section class="phero sec--dark" data-world="{{ sc }}"{% if sc | scene_reach %} style="{{ sc | scene_reach }}"{% endif %}>
  <div class="container">
    {% if page.crumbs and page.crumbs.length %}
    <nav aria-label="Sayfa yolu">
      <ol class="crumbs">
        {% for c in page.crumbs %}<li><a href="{{ c.url }}">{{ c.label }}</a></li>{% endfor %}
        <li aria-current="page">{{ title }}</li>
      </ol>
    </nav>
    {% endif %}
    {% if eyebrow %}<p class="eyebrow" data-reveal>{{ eyebrow }}</p>{% endif %}
    <h1 style="margin-top:1.2rem;--lw:{{ title | longest_word }};--lwe:{{ title | longest_word_em }}" data-reveal data-reveal-delay="1">{{ title }}</h1>
    {% if lead %}<p class="phero__lead" data-reveal data-reveal-delay="2">{{ lead }}</p>{% endif %}
    {% if chips and chips.length %}<div class="phero__meta" data-reveal data-reveal-delay="3">{% for c in chips %}{% if c %}<span class="chip">{{ c }}</span>{% endif %}{% endfor %}</div>{% endif %}
  </div>
</section>
{% endmacro %}

{# Şekil kutusu (js/modules/figure.js): sayfanın parçacık şekli KENDİ yerinde çizilir — yazının, kartın arkasında değil.
   kind: "side" (yapışkan yan sütunda menünün altında; boş yer yoksa kendini gizler) · "pv" (dizinlerde yapışkan önizleme sütunu)
         · "lead" (bölüm içinde metnin yanında).  shapes: boşlukla ayrılmış formasyon kimlikleri; boşsa sayfanın varsayılanı
   (main[data-shapes]). Bölüm işaretleri [data-shape-at] ve üzerine gelme şekilleri [data-shape-hover] aynı beyaz bölümde (.sheet) aranır.
   Süs öğesidir (aria-hidden); JS yoksa, yazdırmada ve yüksek karşıtlıkta görünmez. Wagtail: şablon parçası, veri gerekmez. #}
{% macro fig(kind="side", shapes="") %}
<figure class="fig fig--{{ kind }}" data-shapes="{{ shapes }}" aria-hidden="true"><canvas class="fig__cv"></canvas></figure>
{% endmacro %}
