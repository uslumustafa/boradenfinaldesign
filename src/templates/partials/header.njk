{% from "partials/fxswitch.njk" import fxswitch %}
<header class="hdr on-dark" id="hdr" data-hdr>
  <div class="hdr__bar container">
    {% include "partials/logo.njk" %}

    <nav class="nav" aria-label="Ana menü">
      <ul class="nav__list">
        {# Etkin öğe: adres öğenin adresiyle (ya da match önekiyle, ör. vergi takvimi → Bilgi Merkezi) başlıyorsa. chrome.js › onNavigate aynı kuralı uygular. #}
        {% for item in site.nav %}
        {% set on = item.url !== '/' and (page.url.startsWith(item.url) or (item.match and page.url.startsWith(item.match))) %}
        <li class="nav__item">
          <a class="nav__link{% if on %} is-active{% endif %}" href="{{ item.url }}"{% if item.match %} data-match="{{ item.match }}"{% endif %}
             {%- if item.panel %} data-panel="{{ item.panel }}" aria-expanded="false" aria-controls="mega-{{ item.panel }}"{% endif %}
             {%- if on %} aria-current="true"{% endif %}>{{ item.label }}</a>
        </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="hdr__actions">
      <a class="hdr__icon{% if page.url.startsWith('/arama/') %} is-active{% endif %}" href="/arama/" aria-label="Sitede ara"{% if page.url.startsWith('/arama/') %} aria-current="page"{% endif %}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg>
      </a>
      <a class="btn btn--sm hdr__cta{% if page.url.startsWith(site.cta.url) %} is-active{% endif %}" href="{{ site.cta.url }}"{% if page.url.startsWith(site.cta.url) %} aria-current="page"{% endif %}>{{ site.cta.label }} <span class="arr" aria-hidden="true">→</span></a>
      <button class="hdr__burger" type="button" aria-label="Menüyü aç" aria-expanded="false" aria-controls="mnav"><span></span><span></span></button>
      {# JS kapalıyken menü düğmesi çalışmaz: yerine site haritası bağlantısı görünür (yalnızca html.no-js, dar ekran) #}
      <a class="hdr__map" href="/site-haritasi/" aria-label="Site haritası"><span></span><span></span></a>
    </div>
  </div>

  {# Hizmetler mega paneli. .mega = fareye ait kap (açıldığı anda tam boyuyla), .mega__sheet = perde gibi inen görünen yüzey (chrome.js) #}
  <div class="mega mega--services" id="mega-services" data-mega="services">
    <div class="mega__sheet">
    <div class="container mega__inner">
      <div class="mega__grid">
        {% for g in groups %}
        {# Sütun başlığı alan sayfasına gider; ilk 7 hizmet (Muhasebe dışındaki alanların hepsi; kısa pencerede CSS 5 gösterir), alanın hizmet sayısı «Tüm …» bağlantısında #}
        <div class="mega__col">
          <h3><a href="{{ g.url }}"><span>{{ g.number }}</span> {{ g.short }}</a></h3>
          {% for s in g.services | limit(7) %}
          <a href="{{ s.url }}">{{ s.title }}</a>
          {% endfor %}
          <a class="all" href="{{ g.url }}">Tüm {{ g.short | lower_tr }} hizmetleri <span class="all__n">({{ g.services | length }}) →</span></a>
        </div>
        {% endfor %}
      </div>
    </div>
    </div>
  </div>

  {# Bilgi merkezi mega paneli #}
  <div class="mega mega--insights" id="mega-insights" data-mega="insights">
    <div class="mega__sheet">
    <div class="container mega__inner">
      <div class="mega__grid">
        {% for chunk in [site.insights.slice(0, 3), site.insights.slice(3, 6), site.insights.slice(6, 9)] %}
        <div class="mega__col">
          {% for it in chunk %}
          <a href="{{ it.url }}">{{ it.label }}<small>{{ it.desc }}</small></a>
          {% endfor %}
        </div>
        {% endfor %}
        <div class="mega__col">
          <a href="/bilgi-merkezi/"><strong>Bilgi merkezine git</strong><small>Tüm yayınlar, arşiv ve araçlar</small></a>
        </div>
      </div>
    </div>
    </div>
  </div>
</header>

{# Mobil menü #}
<nav class="mnav on-dark" id="mnav" aria-label="Mobil menü">
  <div class="mnav__inner">
    <ul class="mnav__list">
      <li>
        <details>
          <summary>Hizmetler</summary>
          <div class="mnav__sub">
            {% for g in groups %}<a href="{{ g.url }}">{{ g.number }} — {{ g.name }}</a>{% endfor %}
            <a href="/hizmetler/"><strong>Tüm hizmetler</strong></a>
          </div>
        </details>
      </li>
      <li><a href="/sektorler/">Sektörler</a></li>
      <li>
        <details>
          <summary>Bilgi Merkezi</summary>
          <div class="mnav__sub">
            {% for it in site.insights %}<a href="{{ it.url }}">{{ it.label }}</a>{% endfor %}
          </div>
        </details>
      </li>
      <li><a href="/hesaplayicilar/">Hesaplayıcılar</a></li>
      <li><a href="/hakkimizda/">Hakkımızda</a></li>
      <li><a href="/kariyer/">Kariyer</a></li>
    </ul>
    <div class="mnav__foot">
      <a class="btn" href="{{ site.cta.url }}">{{ site.cta.label }} <span class="arr" aria-hidden="true">→</span></a>
      {% if contact.phone %}<a href="tel:{{ contact.phoneHref }}">{{ contact.phone | phone }}</a>{% endif %}
      {% if contact.email %}<a href="mailto:{{ contact.email }}">{{ contact.email }}</a>{% endif %}
      {# hareket ayarı menüden de değiştirilebilsin: sayfa sonuna inmeden (U-21) #}
      {{ fxswitch("fxlabel-m", "mnav__fx") }}
    </div>
  </div>
</nav>
