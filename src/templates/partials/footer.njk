{% from "partials/fxswitch.njk" import fxswitch %}
<footer class="ftr on-dark" id="footer">
  <div class="container">
    <div class="ftr__top">
      <div class="ftr__brand">
        {% include "partials/logo.njk" %}
        <p>{{ data.content.about.foundation }}</p>
        {# genel iletişim bilgileri boşsa (content.json › contact) satır çizilmez; hiçbiri yoksa adres bloğu da yok #}
        {% if contact.hasAddress or contact.phone or contact.email %}
        <address class="ftr__addr">
          {% if contact.street %}{{ contact.street }}<br>{% endif %}
          {% if contact.line2 %}{{ contact.line2 }}<br>{% endif %}
          {% if contact.phone %}<a href="tel:{{ contact.phoneHref }}">{{ contact.phone | phone }}</a>{% endif %}{% if contact.phone and contact.email %} ·{% endif %}
          {% if contact.email %}<a href="mailto:{{ contact.email }}">{{ contact.email }}</a>{% endif %}
        </address>
        {% endif %}
      </div>

      <nav class="ftr__cols" aria-label="Alt menü">
        <div>
          <h2>Hizmet alanları</h2>
          {% for g in groups %}<a href="{{ g.url }}">{{ g.name }}</a>{% endfor %}
        </div>
        <div>
          <h2>Bilgi merkezi</h2>
          {% for it in site.insights %}<a href="{{ it.url }}">{{ it.label }}</a>{% endfor %}
        </div>
        <div>
          <h2>Keşfet</h2>
          <a href="/hesaplayicilar/">Hesaplayıcılar</a>
          <a href="/sektorler/">Sektörler</a>
          <a href="/arama/">Site içi arama</a>
          <a href="/site-haritasi/">Site haritası</a>
        </div>
        <div>
          <h2>Kurumsal</h2>
          {% for it in site.footerLinks.kurumsal %}<a href="{{ it.url }}">{{ it.label }}</a>{% endfor %}
          {% for it in site.footerLinks.yasal %}<a href="{{ it.url }}">{{ it.label }}</a>{% endfor %}
        </div>
      </nav>
    </div>

    <div class="ftr__legal">
      <p>{{ site.disclaimer }}</p>
      <div class="ftr__row">
        <span>© {{ site.year }} {{ site.legalName }}</span>
        {{ fxswitch("fxlabel") }}
      </div>
    </div>
  </div>
</footer>
