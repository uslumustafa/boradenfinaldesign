{% extends "layouts/base.njk" %}
{% import "partials/macros.njk" as m %}

{% block main %}

{# ───────── 1 · Giriş + Hakkımızda: koyu sahne üstüne beyaz sayfa biner ───────── #}
<div class="stack" data-stack>
  <section class="hero sec--dark" id="giris" data-world="0" data-chapter="Giriş" data-hero>
    <div class="container hero__inner">
      <p class="eyebrow hero__eyebrow" data-hero-in="1">Bağımsız denetim · Vergi · Danışmanlık</p>

      <h1 class="hero__title" aria-label="{{ site.tagline }}">
        <span class="line" aria-hidden="true"><span data-hero-in="2">Tam<i class="p p--b">,</i></span></span>
        <span class="line" aria-hidden="true"><span data-hero-in="3">doğru<i class="p p--r">,</i></span></span>
        <span class="line" aria-hidden="true"><span data-hero-in="4">zamanında<i class="p p--g">.</i></span></span>
      </h1>

      <div class="hero__foot">
        <p class="hero__text" data-hero-in="5">{{ data.content.about.foundation }}</p>
        <div class="hero__btns" data-hero-in="6">
          <a class="btn" href="/hizmetler/">Hizmetlerimiz {{ m.arrow() }}</a>
          <a class="btn btn--ghost" href="/iletisim/">İletişime geçin</a>
        </div>
      </div>

      <a class="hero__scroll" href="#hakkimizda" data-hero-in="7"><span class="hero__scroll-line" aria-hidden="true"></span>Kaydırın</a>
    </div>
  </section>

  <section class="intro sec--paper" id="hakkimizda" data-chapter="Hakkımızda">
    <div class="container">
      <div class="intro__grid">
        <p class="eyebrow" data-reveal>Boraden hakkında</p>
        <div>
          <p class="statement" data-lit>Denetim, vergi ve danışmanlık süreçlerinde kapsamı önce birlikte netleştirir, çalışmayı kayda ve belgeye dayandırır, sonucu açıklanabilir biçimde raporlarız.</p>
          <p class="intro__overview" data-reveal>{{ data.content.about.overview }}</p>
          <p data-reveal><a class="textlink" href="/hakkimizda/">Hakkımızda {{ m.arrow() }}</a></p>
        </div>
      </div>

      <dl class="figures">
        <div class="figure" data-reveal data-reveal-delay="0">
          <dt>Kuruluş yılı</dt>
          <dd class="tnum">{{ site.founded }}</dd>
        </div>
        <div class="figure" data-reveal data-reveal-delay="1">
          <dt>Hizmet alanı</dt>
          <dd class="tnum" data-count="{{ groups | length }}">{{ groups | length }}</dd>
        </div>
        <div class="figure" data-reveal data-reveal-delay="2">
          <dt>Hizmet başlığı</dt>
          <dd class="tnum" data-count="{{ services | length }}">{{ services | length }}</dd>
        </div>
        <div class="figure" data-reveal data-reveal-delay="3">
          <dt>Hesaplama aracı</dt>
          <dd class="tnum" data-count="{{ (model.calculators | length) or 12 }}">{{ (model.calculators | length) or 12 }}</dd>
        </div>
      </dl>
    </div>
  </section>
</div>

{# ───────── 2 · Hizmet alanları: sabitlenen sahne, scroll ile değişir ───────── #}
<section class="areas sec--dark" id="alanlar" data-areas data-world-range="1,6" data-chapter="Hizmetler" style="--n: {{ groups | length }}">
  <div class="areas__track">
    <div class="areas__stage">
      <div class="container areas__grid">
        <header class="areas__head">
          <p class="eyebrow" data-reveal>Hizmet alanları</p>
          <h2 data-reveal data-reveal-delay="1">Altı alan.<br><em>İhtiyaca göre kapsam.</em></h2>
        </header>

        <ol class="areas__list">
          {% for g in groups %}
          <li class="area{% if loop.first %} is-active{% endif %}" data-area="{{ loop.index0 }}" data-fig="Şekil {{ g.number }} · {{ g.figure }}">
            <a class="area__link" href="{{ g.url }}">
              <span class="area__no tnum">{{ g.number }}</span>
              <span class="area__name">{{ g.name }}</span>
              <span class="area__go" aria-hidden="true">→</span>
            </a>
            <div class="area__body">
              <div class="area__inner">
                <p class="area__desc">{{ g.description }}</p>
                <ul class="area__services">
                  {% for s in g.services | limit(4) %}<li><a href="{{ s.url }}">{{ s.title }}</a></li>{% endfor %}
                </ul>
                <a class="textlink" href="{{ g.url }}">Alana göz atın {{ m.arrow() }}</a>
              </div>
            </div>
          </li>
          {% endfor %}
        </ol>

        <div class="areas__visual" aria-hidden="true">
          <div class="areas__cap mono">
            <span data-areas-cap>Şekil {{ groups[0].number }} · {{ groups[0].figure }}</span>
            <span class="areas__count tnum"><b data-areas-idx>01</b> / {{ groups | length | pad2 }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{# ───────── 3 · Yaklaşım ───────── #}
<section class="method sec--paper" id="yaklasim" data-chapter="Yaklaşım">
  <div class="container">
    <div class="method__head g12">
      <div class="gc" style="--gc: 1 / span 7">
        {{ m.head("Yaklaşım", "Önce kapsam,<br><em>sonra çalışma.</em>") }}
      </div>
      <div class="gc" style="--gc: 8 / span 5">
        <p class="lead" data-reveal data-reveal-delay="2">{{ data.content.about.method }}</p>
      </div>
    </div>

    <ol class="steps" data-steps>
      <li class="step" data-reveal>
        <span class="step__no mono">01</span>
        <h3>Tanışma ve kapsam</h3>
        <p>Faaliyetler, mevcut süreçler ve beklentiler dinlenir; çalışmanın kapsamı ve takvimi netleştirilir.</p>
      </li>
      <li class="step" data-reveal data-reveal-delay="1">
        <span class="step__no mono">02</span>
        <h3>Planlama</h3>
        <p>İlgili uzmanlık alanları belirlenir; gereken belge ve veriler önceden bildirilir.</p>
      </li>
      <li class="step" data-reveal data-reveal-delay="2">
        <span class="step__no mono">03</span>
        <h3>Uygulama</h3>
        <p>Çalışma kayıt ve belgelere dayanarak yürütülür; ara bulgular ilgili kişilerle paylaşılır.</p>
      </li>
      <li class="step" data-reveal data-reveal-delay="3">
        <span class="step__no mono">04</span>
        <h3>Raporlama</h3>
        <p>Sonuçlar varsayımları ve sınırlarıyla birlikte raporlanır; sonraki adımlar birlikte konuşulur.</p>
      </li>
    </ol>

    <div class="principles">
      {% for p in data.content.about.principles %}
      <article class="principle principle--{{ ['b', 'r', 'g'][loop.index0] }}" data-reveal data-reveal-delay="{{ loop.index0 }}">
        <h3>{{ p[0] }}</h3>
        <p>{{ p[1] }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# ───────── 4 · Fotoğraf arası (arşiv) ───────── #}
<section class="band" aria-label="Çalışma masası">
  <div class="band__media" data-parallax="0.18">
    {{ m.photo("table-top-2", sizes="100vw", cls="band__img") }}
  </div>
</section>

{# ───────── 5 · Hesaplayıcılar ───────── #}
<section class="tools sec--paper2" id="araclar" data-chapter="Hesaplayıcılar">
  <div class="container">
    <div class="tools__grid">
      <div class="tools__intro">
        {{ m.head("Hesaplayıcılar", "Rakamları<br><em>kendiniz de görün.</em>", "Maaş, KDV, kıdem tazminatı ve daha fazlası için, güncel yıl parametreleriyle çalışan hesaplama araçları.") }}
        <p data-reveal data-reveal-delay="3"><a class="btn" href="/hesaplayicilar/">Tüm hesaplayıcılar {{ m.arrow() }}</a></p>
      </div>

      <form class="mini" data-mini="kdv" data-reveal data-reveal-delay="2" aria-label="Hızlı KDV hesabı" onsubmit="return false">
        <p class="mini__title"><span class="eyebrow">Hızlı hesap</span></p>
        <h3 class="mini__h">KDV hesaplama</h3>
        <div class="mini__row">
          <label class="field">
            <span class="field__label">Tutar</span>
            <span class="field__box"><input name="amount" type="text" inputmode="decimal" value="10.000" autocomplete="off"><i>₺</i></span>
          </label>
          <label class="field">
            <span class="field__label">KDV oranı</span>
            <span class="field__box">
              <select name="rate">
                <option value="20" selected>%20</option>
                <option value="10">%10</option>
                <option value="1">%1</option>
              </select>
            </span>
          </label>
        </div>
        <div class="seg" role="radiogroup" aria-label="Tutarın türü">
          <label><input type="radio" name="mode" value="excl" checked><span>KDV hariç</span></label>
          <label><input type="radio" name="mode" value="incl"><span>KDV dahil</span></label>
        </div>
        <dl class="mini__out" aria-live="polite">
          <div><dt>KDV hariç</dt><dd class="tnum" data-out="net">—</dd></div>
          <div><dt>KDV tutarı</dt><dd class="tnum" data-out="vat">—</dd></div>
          <div class="is-main"><dt>KDV dahil toplam</dt><dd class="tnum" data-out="gross">—</dd></div>
        </dl>
        <p class="mini__note">Tahmini sonuçtur; genel bilgilendirme amaçlıdır.</p>
      </form>
    </div>

    <ul class="toolcards">
      {# hesaplayıcı seçkisi: başlık ve kısa açıklama hesaplayıcı tanımından gelir (Wagtail: HomePage.featured_calculators) #}
      {% set picks = ['maas-hesaplama', 'isveren-maliyeti-hesaplama', 'kidem-tazminati-hesaplama', 'gelir-vergisi-hesaplama'] %}
      {% for slug in picks %}
      {% set t = model.calcBySlug[slug] %}
      {% if t %}
      <li data-reveal data-reveal-delay="{{ loop.index0 }}">
        <a class="toolcard" href="{{ t.url }}">
          <span class="toolcard__t">{{ t.title }}</span>
          <span class="toolcard__d">{{ t.short }}</span>
          <span class="toolcard__go" aria-hidden="true">→</span>
        </a>
      </li>
      {% endif %}
      {% endfor %}
    </ul>
  </div>
</section>

{# ───────── 6 · Sektörler (koyu, dünya görünür) ───────── #}
<section class="sectors sec--dark" id="sektorler" data-world="0" data-world-pose="2" data-chapter="Sektörler">
  <div class="container">
    <div class="sectors__head g12">
      <div class="gc" style="--gc: 1 / span 7">
        {{ m.head("Sektörler", "Sektörün dilini<br><em>bilen bir bakış.</em>") }}
      </div>
      <div class="gc sectors__side" style="--gc: 9 / span 4">
        <p class="lead" data-reveal data-reveal-delay="2">Denetim, vergi ve danışmanlık gündemi sektörden sektöre değişir. Her sektör için güncel konuları ayrı sayfalarda topluyoruz.</p>
      </div>
    </div>

    <ul class="sectorlist">
      {% for s in model.sectors | limit(8) %}
      <li data-reveal>
        <a class="sector" href="/sektorler/{{ s.slug }}/">
          <span class="sector__no mono tnum">{{ loop.index | pad2 }}</span>
          <span class="sector__name">{{ s.name }}</span>
          <span class="sector__short">{{ s.short }}</span>
          <span class="sector__go" aria-hidden="true">→</span>
        </a>
      </li>
      {% endfor %}
    </ul>
    <p class="sectors__more" data-reveal><a class="textlink" href="/sektorler/">Tüm sektörler {{ m.arrow() }}</a></p>
  </div>
</section>

{# ───────── 7 · Bilgi merkezi ───────── #}
<section class="insights sec--paper" id="bilgi" data-chapter="Bilgi merkezi">
  <div class="container">
    <div class="insights__head">
      {{ m.head("Bilgi merkezi", "Gündemi<br><em>kaynağıyla birlikte.</em>") }}
      <p data-reveal data-reveal-delay="2"><a class="textlink" href="/bilgi-merkezi/">Tüm yayınlar {{ m.arrow() }}</a></p>
    </div>

    <div class="insights__grid">
      {% set feat = model.latest[0] %}
      {% if feat %}
      <a class="feat" href="{{ feat.url }}" data-reveal>
        <span class="feat__meta mono"><span>{{ feat.typeLabel }}</span><span>{{ feat.category }}</span><time datetime="{{ feat.date }}">{{ feat.date | date_tr }}</time></span>
        <h3 class="feat__t">{{ feat.title }}</h3>
        <p class="feat__s">{{ feat.summary }}</p>
        <span class="feat__go textlink">Okuyun {{ m.arrow() }}</span>
      </a>
      {% endif %}

      <ul class="newslist">
        {% for p in model.latest.slice(1, 5) %}
        <li data-reveal data-reveal-delay="{{ loop.index0 }}">
          <a class="news" href="{{ p.url }}">
            <span class="news__meta mono"><span>{{ p.typeLabel }}</span><time datetime="{{ p.date }}">{{ p.date | date_short }}</time></span>
            <span class="news__t">{{ p.title }}</span>
          </a>
        </li>
        {% endfor %}
        <li data-reveal>
          <a class="news news--archive" href="/bilgi-merkezi/sirkulerler/">
            <span class="news__meta mono"><span>Arşiv</span><span class="tnum">{{ model.archive | length }} sirküler</span></span>
            <span class="news__t">Sirküler arşivi ({{ model.archiveYears | last }}–{{ model.archiveYears | first }})</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

{% include "partials/cta.njk" %}
{% endblock %}
