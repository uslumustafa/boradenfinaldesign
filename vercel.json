{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:prod",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        }
      ]
    },
    {
      "source": "/assets/js/chunks/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/hizmetler/danismanlik/",
      "destination": "/hizmetler/kurumsal-finansman/",
      "permanent": true
    },
    {
      "source": "/hizmetler/insan-kaynaklari/",
      "destination": "/hizmetler/muhasebe/",
      "permanent": true
    },
    {
      "source": "/hizmetler/sistemler/",
      "destination": "/hizmetler/dijital-donusum/",
      "permanent": true
    },
    {
      "source": "/hizmetler/vergi/mali-musavirlik-ve-muhasebe/",
      "destination": "/hizmetler/muhasebe/mali-musavirlik-ve-muhasebe/",
      "permanent": true
    },
    {
      "source": "/hizmetler/vergi/cari-hesap-mutabakatlarinin-yapilmasi/",
      "destination": "/hizmetler/muhasebe/cari-hesap-mutabakatlarinin-yapilmasi/",
      "permanent": true
    },
    {
      "source": "/hizmetler/denetim/kurumsal-raporlama/",
      "destination": "/hizmetler/muhasebe/kurumsal-raporlama/",
      "permanent": true
    },
    {
      "source": "/hizmetler/denetim/ufrs-tfrs-raporlama/",
      "destination": "/hizmetler/muhasebe/ufrs-tfrs-raporlama/",
      "permanent": true
    },
    {
      "source": "/hizmetler/danismanlik/raporlama/",
      "destination": "/hizmetler/muhasebe/raporlama/",
      "permanent": true
    },
    {
      "source": "/hizmetler/insan-kaynaklari/insan-kaynaklari-ve-bordro/",
      "destination": "/hizmetler/muhasebe/insan-kaynaklari-ve-bordro/",
      "permanent": true
    },
    {
      "source": "/hizmetler/insan-kaynaklari/bordrolama/",
      "destination": "/hizmetler/muhasebe/bordrolama/",
      "permanent": true
    },
    {
      "source": "/hizmetler/insan-kaynaklari/sgk-dosya-acilisi/",
      "destination": "/hizmetler/muhasebe/sgk-dosya-acilisi/",
      "permanent": true
    },
    {
      "source": "/hizmetler/insan-kaynaklari/ev-hizmetlisi-sgk-dosya-acilisi/",
      "destination": "/hizmetler/muhasebe/ev-hizmetlisi-sgk-dosya-acilisi/",
